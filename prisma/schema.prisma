// Prisma schema for the Financial Consulting Website
// Database: PostgreSQL
//
// 3NF proof:
//   services         — PK: id; name is UNIQUE (second candidate key). No non-key
//                      attribute depends on any other non-key attribute. ✓ BCNF
//   appointments     — PK: id (single-column). Every non-key column depends only
//                      on id; serviceId is a FK that removes service-name redundancy. ✓ 3NF
//   users            — PK: id. All attributes (email, passwordHash, name, createdAt)
//                      depend solely on id. ✓ 3NF
//   roles            — PK: id; name depends only on id. ✓ BCNF
//   permissions      — PK: id; name and description depend only on id. ✓ 3NF
//   user_roles       — Composite PK (userId, roleId). No non-key attributes. ✓ BCNF
//   role_permissions — Composite PK (roleId, permissionId). No non-key attrs. ✓ BCNF
//   logs             — PK: id. All columns depend only on id. groupId is intentionally
//                      denormalised (captures the user's role at action time for audit
//                      immutability — a recognised exception to strict 3NF). ✓ 3NF*
//   suspicious_users — PK: userId (FK). reason, score, detectedAt, resolvedAt all
//                      depend only on userId. ✓ 3NF

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Lookup table: normalises service names ────────────────────────────────────
model Service {
  id           Int           @id @default(autoincrement())
  name         String        @unique @db.VarChar(200)
  appointments Appointment[]

  @@map("services")
}

// ── Appointment status enum ───────────────────────────────────────────────────
enum AppointmentStatus {
  confirmed
  pending
  completed
  cancelled
}

// ── Core entity ───────────────────────────────────────────────────────────────
model Appointment {
  id         String            @id @db.VarChar(50)
  ownerEmail String            @db.VarChar(255)
  serviceId  Int
  service    Service           @relation(fields: [serviceId], references: [id])
  date       String            @db.VarChar(10)
  time       String            @db.VarChar(5)
  status     AppointmentStatus @default(pending)
  clientName String            @db.VarChar(200)
  phone      String            @default("") @db.VarChar(30)
  notes      String            @default("") @db.Text
  createdAt  String            @db.VarChar(10)

  @@index([ownerEmail])
  @@map("appointments")
}

// ── User accounts ─────────────────────────────────────────────────────────────
model User {
  id           String          @id @db.VarChar(50)
  email        String          @unique @db.VarChar(255)
  passwordHash String          @db.VarChar(255)
  name         String          @db.VarChar(200)
  createdAt    DateTime        @default(now())
  userRoles    UserRole[]
  logs         Log[]
  suspicious   SuspiciousUser?

  @@index([email])
  @@map("users")
}

// ── Role definitions ──────────────────────────────────────────────────────────
model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique @db.VarChar(50)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

// ── Permission definitions ────────────────────────────────────────────────────
model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique @db.VarChar(100)
  description     String           @default("") @db.Text
  rolePermissions RolePermission[]

  @@map("permissions")
}

// ── Join: users ↔ roles (many-to-many) ───────────────────────────────────────
model UserRole {
  userId String
  roleId Int
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

// ── Join: roles ↔ permissions (many-to-many) ─────────────────────────────────
model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ── Action audit log ──────────────────────────────────────────────────────────
// groupId is intentionally denormalised to preserve the user's role at the
// exact moment the action occurred (audit immutability).
// sessionId links the log entry back to the browser session that performed it.
model Log {
  id        String   @id @db.VarChar(50)
  userId    String   @db.VarChar(50)
  user      User     @relation(fields: [userId], references: [id])
  userEmail String   @db.VarChar(255)
  groupId   String   @db.VarChar(20)
  action    String   @db.VarChar(500)
  details   Json     @default("{}")
  ipAddress String   @default("") @db.VarChar(45)
  sessionId String?  @db.VarChar(100)
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
  @@index([sessionId])
  @@map("logs")
}

// ── Suspicious user observation list ─────────────────────────────────────────
// triggeredRules records which detection rules have fired for this user.
// updatedAt is refreshed automatically every time the record is modified.
model SuspiciousUser {
  userId         String    @id @db.VarChar(50)
  user           User      @relation(fields: [userId], references: [id])
  reason         String    @db.Text
  score          Int       @default(0)
  triggeredRules Json      @default("[]")
  aiAnalysis     Json?     // AI-generated behavior analysis (Ollama)
  detectedAt     DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  resolvedAt     DateTime?

  @@map("suspicious_users")
}
